# Server
PORT=3000
NODE_ENV=development

# Postgres — matches docker-compose.yml defaults
DATABASE_URL=postgres://anchor:anchor@localhost:5434/anchor_dev

# Postgres — test DB (vitest integration suites skip when unset)
TEST_DATABASE_URL=postgres://anchor:anchor@localhost:5434/anchor_test

# Email (Mailgun — D-023: matches anchor-hub).
#   - MAILGUN_API_KEY unset → stub mode, sendEmail() logs and returns ok:false.
#   - 'dry-run' → renders template + returns success without calling Mailgun.
#   - Real key → POSTs to https://api.mailgun.net/v3/$MAILGUN_DOMAIN/messages
#     with HTTP Basic (`api:<key>`).
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_DEFAULT_FROM=AnchorCorps Builder <builder@anchorcorps.com>

# Admin API token (Task 1.7). Pass as X-Admin-Token on the save / list /
# restore routes. If unset, all /api/sites/* admin routes return 401.
# Phase 8 keeps this as a CI/service + break-glass path: requireAdmin accepts a
# Studio Google session OR this token (D-034/D-046), so prod never locks out.
ADMIN_API_TOKEN=

# Studio control-hub Google login (Phase 8, Track A — D-034/D-046).
#   Mode switch (src/server/auth/studio-auth.ts):
#     - all three present              → "google"   (real Google OAuth)
#     - absent + NODE_ENV != production → "dev"      (auto-granted session)
#     - absent + production             → "disabled" (prod stays on the token)
#   Locally leave BLANK → "dev" (no Google round-trip). In prod these come from
#   Secret Manager via Cloud Run --set-secrets — NEVER commit real values
#   (hard rule #8). Google Console redirect URI must be
#   <STUDIO_ORIGIN>/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BETTER_AUTH_SECRET=
# Optional override of the Studio origin (baseURL + OAuth callback base).
# Defaults: https://studio.anchorcorps.com (prod) / http://studio.localhost:3000 (dev).
STUDIO_ORIGIN=

# DNS provider for tenant provisioning (src/server/dns/).
# DNS_PROVIDER: kinsta | godaddy | manual | cloud-dns.
#   unset → kinsta when the Kinsta creds below are set (anchorcorps.com's real
#   zone lives on Kinsta DNS — GoDaddy 404s UNKNOWN_DOMAIN for it), else
#   godaddy when the GoDaddy creds are set, else manual.
#   manual surfaces the required records + verifies by live DNS lookup (no writes).
#   cloud-dns is interface-ready but not yet implemented.
DNS_PROVIDER=
# Kinsta DNS API credentials (used when DNS_PROVIDER=kinsta, or by default
# when set — see above). In prod these live in Secret Manager (project
# anchor-hub-480305, KINSTA_API_KEY / KINSTA_AGENCY_ID — the latter maps to
# this KINSTA_COMPANY_ID env var, same value) and are wired onto the Cloud
# Run services via cloudbuild.yaml --set-secrets.
KINSTA_API_KEY=
KINSTA_COMPANY_ID=
# GoDaddy API credentials (used when DNS_PROVIDER=godaddy). In prod these live in
# Secret Manager (project anchor-hub-480305) and are wired onto the Cloud Run
# services. NOTE: names are case-sensitive — must be UPPERCASE.
GODADDY_API_KEY=
GODADDY_API_SECRET=
# Optional GoDaddy API base override (defaults to https://api.godaddy.com).
GODADDY_API_BASE=

# AI (Phase 6 editor + the site agent, src/server/ai/). In prod these live in
# Secret Manager (project anchor-hub-480305) and are wired onto the Cloud Run
# service via cloudbuild.yaml --set-secrets.
#   - ANTHROPIC_API_KEY unset → stub mode (no spend); 'dry-run' → dry-run mode;
#     any other value → live Claude API calls (see src/server/ai/config.ts).
ANTHROPIC_API_KEY=
#   - PIXABAY_API_KEY unset → search_stock_images returns deterministic stub
#     hits (example.invalid URLs), no network (src/server/media/pixabay.ts).
PIXABAY_API_KEY=
# Site agent (src/server/ai/agent/) knobs — both optional, shown at default.
#   - AI_AGENT_TOKEN_BUDGET: max input+output tokens per conversation per day
#     before the agent stops gracefully between tool calls.
AI_AGENT_TOKEN_BUDGET=1000000
#   - AI_AGENT_MAX_TOOL_CALLS: hard cap on tool calls per job batch. Hitting
#     it doesn't end the build — src/server/jobs/agent-turn.ts auto-continues
#     into a fresh batch (see AI_AGENT_MAX_CONTINUATIONS below).
AI_AGENT_MAX_TOOL_CALLS=30
#   - AI_AGENT_MAX_CONTINUATIONS: cap on auto-continue rounds per user
#     message (read by src/server/jobs/agent-turn.ts's handleAgentTurn, not
#     runAgentTurn itself). One user message can drive up to
#     (AI_AGENT_MAX_CONTINUATIONS + 1) * AI_AGENT_MAX_TOOL_CALLS tool calls
#     (120 at these defaults) before the agent pauses with a "Paused after N
#     batches" note and waits for the operator to send another message.
AI_AGENT_MAX_CONTINUATIONS=3

# GitHub content sync (docs/github-sync.md) — bidirectional export/import
# between a site and a content-monorepo repo on GitHub. DISABLED BY DEFAULT:
# resolveGitMode() (src/server/git/client.ts) is "disabled" whenever
# GITHUB_CONTENT_TOKEN is unset, the literal placeholder value "disabled"
# (the value Task 8 seeded into Secret Manager before the operator provisions
# a real PAT), or GITHUB_CONTENT_REPO is empty/unset — in all of those cases
# every git-sync entry point (routes, jobs, the publish trigger) short-
# circuits with zero GitHub network I/O, which is what keeps local dev and CI
# safe with these left blank.
#   - GITHUB_CONTENT_TOKEN: fine-grained GitHub PAT, Contents Read/Write scoped
#     to the one content repo. In prod this lives in Secret Manager (project
#     anchor-hub-480305) via cloudbuild.yaml --set-secrets.
GITHUB_CONTENT_TOKEN=
#   - GITHUB_WEBHOOK_SECRET: HMAC secret GitHub signs push-webhook payloads
#     with (X-Hub-Signature-256). Also Secret Manager in prod.
GITHUB_WEBHOOK_SECRET=
#   - GITHUB_CONTENT_REPO: "owner/repo" for the content monorepo. Plain env
#     (not a secret) — set via cloudbuild.yaml --set-env-vars.
GITHUB_CONTENT_REPO=
